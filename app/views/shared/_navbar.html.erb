  <%= link_to 'Records', records_path %>
  <% if mechanic_signed_in? || admin_user_signed_in? %>
    <%= link_to 'Customers', customers_index_path %>
    <%= link_to 'Vehicles', vehicles_path %>
    <%= link_to 'Parts', parts_path %>
    <%= link_to 'Tags', tags_index_path %>
  <% end %>
  <% unless admin_user_signed_in? %>
  <%= link_to 'Profile', profile_show_path %>
