<h1>New Mechanic</h1>
<%= form_with model: @mechanic, html: { class: "form" } do |form| %>
<%= hidden_field_tag :return_to, params[:return_to] %>
  <div class = "field">
    <%= form.label :name %><br>
    <%= form.text_field :name %>
  </div>

  <div class = "field">
    <%= form.label :experience %><br>
    <%= form.text_field :experience %>
  </div>

  <div class = "field">
    <%= form.submit "Create Mechanic" %>
  </div>
<% end %>


