<%= form_with(model: @vehicle, local: true, html: { class: "form" }) do |form| %>
    <h1>New Vehicle</h1>
    
    <div class="field">
        <%= form.label :number_plate %>
        <%= form.text_field :number_plate, required: true %>
    </div>
    
    <div class="field">
        <%= form.label :model %>
        <%= form.text_field :model, required: true %>
    </div>
    
    <div class="actions">
        <%= form.submit "Create Vehicle" %>
    </div>
<% end %>