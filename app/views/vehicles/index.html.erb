<h1>Vehicles</h1>
<%= form_with url: vehicles_path, method: :get do %>
  <%= text_field_tag :q, params[:q], placeholder: "Search records..." %>
  <%= submit_tag "Search" %>
<% end %>
<% @vehicles.each do |vehicle| %>
  <div class = "card">
    <p><%= vehicle.number_plate %></p>
    <p><%= vehicle.model %></p>
    <p><%= link_to 'View Details', vehicles_show_path(vehicle.id) %></p>
  </div>
<% end %>
<hr>
