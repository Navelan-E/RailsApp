<!DOCTYPE html>
<html>
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">

  <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

  <head>
    <title><%= content_for(:title) || "App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="App">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <% unless Rails.env.test? %>
      <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <% end %>
    <% unless Rails.env.test? %>
      <%= javascript_include_tag "application", "data-turbo-track": "reload" %>
    <% end %>
  </head>

  <body class="<%= mechanic_signed_in? ? 'mechanic-theme' : 'customer-theme' %>">
  <%= render "shared/navbar" %>
  <%= yield %>

  <div id="flash"
     data-notice="<%= flash[:notice] %>"
     data-alert="<%= flash[:alert] %>">
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const flashDiv = document.getElementById('flash');
      const notice = flashDiv.dataset.notice;
      const alert = flashDiv.dataset.alert;
      
      if (notice && notice.trim() !== '') {
        toastr.success(notice);
      }
      if (alert && alert.trim() !== '') {
        toastr.error(alert);
      }
    });
  </script>

</body>

<style>
  .field_with_errors { display: contents; }
  .field_with_errors input, .field_with_errors select { border: 2px solid red transparent; }
</style>

</html>
