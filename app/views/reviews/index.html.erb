<h1>Reviews</h1>


<hr>

<% @all_reviews.each do |review| %>
  <div class="card">
    <p><%= review.content %></p>
    <p><%= review.reviewable.mechanic.name %></p>
    <p><%= review.customer.name %></p>
    <% if review.customer_id == current_customer&.id %>
      <%= link_to 'Edit', edit_review_path(review) %>
      <%= button_to 'Delete', review, method: :delete, data: { turbo_confirm: 'Are you sure?' } %>
    <% end %>
    <p>
      <%= link_to 'View Summary', summary_path(review.reviewable.summary) %>
    </p>
  </div>
<% end %>

<%= link_to 'Back to Summary', summaries_path %>