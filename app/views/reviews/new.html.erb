<h1>Reviews#new</h1>
<p>Find me in app/views/reviews/new.html.erb</p>
<p>Creating a new review for Mechanic: <%= @record.mechanic.name %></p>
<%= form_with(model: @review) do |f| %>  <div>
    <%= hidden_field_tag :record_id, @record.id %>
    <%= f.label :content %><br>
    <%= f.text_area :content %>
  </div>
  <%= f.submit "Add Review" %>
<% end %>
<% link_to 'Back to Summary', summaries_path %>
