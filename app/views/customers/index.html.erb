<h1>Customers</h1>
<% @customers.each do |customer| %>
  <div class = "card">
    <p><%= customer.name %></p>
    <p><%= customer.phone %></p>
    <p><%= customer.email %></p>
    <p><%= customer.id %></p>
    <p><%= link_to 'View Details', customers_show_path(id: customer.id) %></p>
  </div>
<% end %>
<hr>

