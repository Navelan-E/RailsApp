<h1>Summaries</h1>

<% @summary.each do |summary| %>
  <div class = "card">
    <h2><%= link_to "Summaries ##{summary.id}", summary_path(summary) %></h2>
    <p>Vehicle: <%= summary.record.vehicle.number_plate %> - <%= summary.record.vehicle.model %></p>
    <p>Customer: <%= summary.record.vehicle.customer.name %> - <%= summary.record.vehicle.customer.phone %></p>
    <p>Issue: <%= summary.summary_text %></p>
    <p>Assigned Mechanic: <%= summary.record.mechanic&.name || "Unassigned" %></p>
    <p>Customer Notes: <%= summary.customer_notes %></p>
    <%= link_to 'Show', summary_path(summary) %>
  </div>
  <hr>
<% end %>