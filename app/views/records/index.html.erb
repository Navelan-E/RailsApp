<h1>Records</h1>
<%= form_with url: records_path, method: :get do %>
  <%= text_field_tag :q, params[:q], placeholder: "Search records..." %>
  <%= submit_tag "Search" %>
<% end %>
<% if mechanic_signed_in?%>
  <%= link_to 'New Record', records_new_path %>
<% end %>
<hr>
<% @records.each do |record| %>
  <%if mechanic_signed_in? || current_customer == record.customer%>
    <div class = "card">
      <h2><%= link_to "#{record.vehicle.number_plate} - #{record.created_at.strftime('%d %b %Y')}", record_path(record) %></h2>
      <p>Model: <%= record.vehicle.model %></p>
      <p>Customer: <%= record.customer.name %> - <%= record.customer.phone %></p>
      <p>Status: <%= record.status %></p>
      <p>Issue: <%= record.internal_notes %></p>
      <p>Assigned Mechanic: <%= record.mechanic&.name || "Unassigned" %></p>
      <%= link_to 'Edit', edit_record_path(record) %>
      <%= link_to 'Show', record_path(record) %>
    </div>
  <% end %>
<% end %>
<hr>