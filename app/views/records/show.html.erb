<h1>Records</h1>
<div class = "card">
  <h2>Record Details</h2>
  <p>Vehicle: <%= @record.vehicle.number_plate %> - <%= @record.vehicle.model %></p>
  <p>Customer: <%= @record.customer.name %> - <%= @record.customer.phone %></p>
  <p>Status: <%= @record.status %></p>
  <p>Issue: <%= @record.internal_notes %></p>
  <p>Assigned Mechanic: <%= @record.mechanic&.name || "Unassigned" %></p>
  <p>Total Cost: <%= @record.total_cost || "Not Calculated" %></p>
  <% if @record.tags.any? %>
    <p>Tags: <%= @record.tags.map(&:tag).join(", ") || "No tags" %></p>
  <%else%>
    <p>No tags associated with this record.</p>
  <% end %>
  <% if @record.parts.any? %>
    <p>Used Parts: <%= @record.parts.map(&:name).join(", ") || "No parts used" %></p>
  <%else%>
    <p>No parts associated with this record.</p>
  <% end %>
</div>

<div class = "card">
  <h3>Comments = <%= @record.reviews.count %></h3>
  <% @record.reviews.each do |review| %>
    <div class = "card">
      <p><%= review.content %></p>
    </div>
  <% end %>
</div>
<div>
  <%= link_to 'Edit Record', edit_record_path(@record) %>
  <%= link_to 'Back to Records', records_path %>
</div>

